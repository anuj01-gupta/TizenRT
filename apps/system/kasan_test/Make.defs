############################################################################
# apps/system/kasan_test/Make.defs
# Adds selected applications to apps/ build
#
############################################################################

# Gated on the kernel side option rather than one of its own. The app is only
# a way to reach PR_KASAN_SELFTEST, so there is nothing for it to do when the
# kernel was not built with the test it calls.

ifeq ($(CONFIG_MM_KASAN_SELFTEST),y)
CONFIGURED_APPS += system/kasan_test
endif
